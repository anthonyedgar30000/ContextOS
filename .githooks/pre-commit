#!/bin/sh
set -u

repo_root=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$repo_root" ]; then
  echo "pre-commit verification: unable to resolve repository root" >&2
  exit 1
fi

cd "$repo_root" || exit 1

if [ ! -f "verify_cli.py" ]; then
  echo "pre-commit verification: verify_cli.py not found" >&2
  exit 1
fi

echo "pre-commit verification: running verify_cli.py"
python3 verify_cli.py --session session.json --policy policy.yaml --repo "$repo_root"
exit_code=$?

if [ "$exit_code" -ne 0 ]; then
  echo "pre-commit verification: failed; commit aborted" >&2
  exit "$exit_code"
fi

echo "pre-commit verification: passed"
